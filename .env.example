# Copy to .env (gitignored) and fill in. Loaded automatically by the web app
# and the scripts; variables already set in the real environment take precedence.

# Anthropic API key, used by the chat agent and the evals.
ANTHROPIC_API_KEY=

# Shared passphrase for the web access gate (required by the web app).
BREWCHAT_PASSPHRASE=

# Optional: cookie signing key. Derived from the passphrase when unset.
# BREWCHAT_SECRET_KEY=

# Optional: Claude model for the agent and the evals (default claude-haiku-4-5, the cheapest).
# BREWCHAT_MODEL=claude-opus-5

# Optional overrides.
# BREWCHAT_CONFIG=config/supplier.local.toml
# BREWCHAT_LOGS_DIR=logs
